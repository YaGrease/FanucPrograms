/PROG  PICK_AND_PLACE
/ATTR
OWNER		= MNEDITOR;
COMMENT		= "";
PROG_SIZE	= 6776;
CREATE		= DATE 26-08-12  TIME 16:16:52;
MODIFIED	= DATE 26-08-12  TIME 16:16:52;
FILE_NAME	= PICK_AND;
VERSION		= 0;
LINE_COUNT	= 316;
MEMORY_SIZE	= 7308;
PROTECT		= READ_WRITE;
TCD:  STACK_SIZE	= 0,
      TASK_PRIORITY	= 50,
      TIME_SLICE	= 0,
      BUSY_LAMP_OFF	= 0,
      ABORT_REQUEST	= 0,
      PAUSE_REQUEST	= 0;
DEFAULT_GROUP	= 1,*,*,*,*;
CONTROL_CODE	= 00000000 00000000;
LOCAL_REGISTERS	= 0,0,0;
/APPL
/APPL
/MN
   1:  ! Main driving loop ;
   2:  LBL[4:PP_LOOP] ;
   3:   ;
   4:  ! Reset Error Checking ;
   5:  R[24:PICK_CNT_ERR]=0    ;
   6:  R[25:PLACE_CNT_ERR]=0    ;
   7:   ;
   8:  ! Check for recipe reset ;
   9:  IF R[11:RECIPE_IO_IDX]=37,JMP LBL[998] ;
  10:  R[12:RECIPE_OUTPUT]=R[R[99]]    ;
  11:   ;
  12:  ! Checks next recipe output ;
  13:  IF R[12:RECIPE_OUTPUT]=0,JMP LBL[1] ;
  14:   ;
  15:  LBL[24] ;
  16:  ! get out of shroud safely ;
  17:J PR[20] 100% CNT30 ACC50    ;
  18:   ;
  19:  ! Move to next pin (FINE BEFORE) ;
  20:J PR[5:REPO_RCP_PSN] 100% CNT50 ACC65    ;
  21:   ;
  22:  ! Descend to grab pin ;
  23:  PR[2:TMP_REPO_RCP]=PR[5:REPO_RCP_PSN]    ;
  24:  PR[2,3:TMP_REPO_RCP]=PR[2,3:TMP_REPO_RCP]-R[21:PICKUP_CONSTANT]    ;
  25:L PR[2:TMP_REPO_RCP] 100mm/sec FINE    ;
  26:   ;
  27:  ! Ascend with Pin ;
  28:L PR[5:REPO_RCP_PSN] 100mm/sec FINE    ;
  29:   ;
  30:  ! Move safely to shroud ;
  31:  PR[20]=PR[5:REPO_RCP_PSN]    ;
  32:  PR[20,3]=PR[3,3:TMP_CAMERA]    ;
  33:  PR[20,1]=PR[3,1:TMP_CAMERA]-25    ;
  34:  ! (FINE BEFORE) ;
  35:J PR[20] 100% CNT25 ACC70    ;
  36:J PR[3:TMP_CAMERA] 100% FINE ACC50    ;
  37:  WAIT    .10(sec) ;
  38:   ;
  39:   ;
  40:   ;
  41:  ! initiate camera code ;
  42:  R[50:STEP_CNT]=0    ;
  43:  R[51:MAX_STEP_CNT]=92    ;
  44:  R[52:TURN_PER_STEP]=8    ;
  45:  ! maybe go back to 90.7 try 92 ag ;
  46:  R[53:MINIMUM_THRESH]=83    ;
  47:  R[54:ABOVE_THRESH]=0    ;
  48:  R[55:BEST_SCORE]=0    ;
  49:  R[56:DOWN_THRESH]=3    ;
  50:  R[57:CUR_SCORE]=0    ;
  51:  R[58:CUR_DROP]=0    ;
  52:  R[59]=46    ;
  53:  PR[21]=PR[3:TMP_CAMERA]    ;
  54:  PR[22]=PR[3:TMP_CAMERA]    ;
  55:   ;
  56:  R[27]=1    ;
  57:  CALL READ_SCORE    ;
  58:  R[27]=0    ;
  59:  IF R[57:CUR_SCORE]>0,JMP LBL[30] ;
  60:  MESSAGE[FAILED PICK] ;
  61:  IF R[24:PICK_CNT_ERR]=2,JMP LBL[40] ;
  62:  R[24:PICK_CNT_ERR]=R[24:PICK_CNT_ERR]+1    ;
  63:  IF R[28]=2,JMP LBL[41] ;
  64:  JMP LBL[24] ;
  65:   ;
  66:  ! FIND BEST ORIENTATION ;
  67:  ! Rotate to next step ;
  68:  LBL[30] ;
  69:  R[28]=0    ;
  70:  R[24:PICK_CNT_ERR]=0    ;
  71:L PR[21] 2000deg/sec FINE    ;
  72:  WAIT    .05(sec) ;
  73:  CALL READ_SCORE    ;
  74:  IF R[57:CUR_SCORE]>R[55:BEST_SCORE],JMP LBL[31] ;
  75:  IF R[54:ABOVE_THRESH]=1,JMP LBL[33] ;
  76:  JMP LBL[34] ;
  77:   ;
  78:  ! Highest score so far ;
  79:  LBL[31] ;
  80:  R[55:BEST_SCORE]=R[57:CUR_SCORE]    ;
  81:  PR[22]=PR[21]    ;
  82:  IF R[57:CUR_SCORE]>R[53:MINIMUM_THRESH],JMP LBL[32] ;
  83:  JMP LBL[34] ;
  84:   ;
  85:  ! In quality threshold ;
  86:  LBL[32] ;
  87:  R[54:ABOVE_THRESH]=1    ;
  88:  JMP LBL[34] ;
  89:   ;
  90:  ! Significant downturn check ;
  91:  LBL[33] ;
  92:  R[58:CUR_DROP]=R[55:BEST_SCORE]-R[57:CUR_SCORE]    ;
  93:  IF R[58:CUR_DROP]>R[56:DOWN_THRESH],JMP LBL[35] ;
  94:  JMP LBL[34] ;
  95:   ;
  96:  ! Iterate and call next step ;
  97:  LBL[34] ;
  98:  R[50:STEP_CNT]=R[50:STEP_CNT]+1    ;
  99:  IF R[50:STEP_CNT]<>R[59],JMP LBL[63] ;
 100:  PR[21,6]=PR[21,6]+4    ;
 101:  LBL[63] ;
 102:  IF R[50:STEP_CNT]>R[51:MAX_STEP_CNT],JMP LBL[37] ;
 103:  IF R[50:STEP_CNT]>R[59],JMP LBL[64] ;
 104:  PR[21,6]=PR[21,6]+R[52:TURN_PER_STEP]    ;
 105:  JMP LBL[30] ;
 106:  LBL[64] ;
 107:  PR[21,6]=PR[21,6]-R[52:TURN_PER_STEP]    ;
 108:  JMP LBL[30] ;
 109:   ;
 110:  ! Found Peak or no match ;
 111:  LBL[35] ;
 112:J PR[22] 100% CNT100 ACC70    ;
 113:  JMP LBL[36] ;
 114:   ;
 115:  ! Fail Case: No Match ;
 116:  LBL[37] ;
 117:  MESSAGE[NO HIGH MATCH] ;
 118:  R[26:FAILED_PICK_CNT]=R[26:FAILED_PICK_CNT]+1    ;
 119:J PR[22] 100% CNT100 ACC70    ;
 120:  JMP LBL[36] ;
 121:   ;
 122:  ! Done (don't forget to maintain ;
 123:  ! rotation values ;
 124:  LBL[36] ;
 125:  PR[6,6:MOD_RCP_PSN]=PR[22,6]    ;
 126:   ;
 127:  ! Move out of shroud ;
 128:  PR[20]=PR[3:TMP_CAMERA]    ;
 129:  PR[20,1]=PR[20,1]-25    ;
 130:  PR[20,2]=PR[20,2]-R[23:Y_OFFSET_SHROUD]    ;
 131:  PR[20,6]=PR[22,6]    ;
 132:  LBL[25] ;
 133:J PR[20] 100% CNT30 ACC50    ;
 134:   ;
 135:  ! Move to Cable Module (BEFORE FI ;
 136:J PR[6:MOD_RCP_PSN] 100% CNT10 ACC70    ;
 137:   ;
 138:  ! Descend with receptacle ;
 139:  PR[4:TMP_MOD_RCP]=PR[6:MOD_RCP_PSN]    ;
 140:  PR[4,3:TMP_MOD_RCP]=PR[4,3:TMP_MOD_RCP]-R[22:RELEASE_CONSTANT]    ;
 141:L PR[4:TMP_MOD_RCP] 100mm/sec FINE    ;
 142:  WAIT    .10(sec) ;
 143:  ! Ascend without receptacle ;
 144:L PR[6:MOD_RCP_PSN] 100mm/sec FINE    ;
 145:  ! Move safely back to shroud ;
 146:J PR[20] 100% CNT30 ACC70    ;
 147:  ! Check without receptacle ;
 148:  R[57:CUR_SCORE]=0    ;
 149:J PR[22] 100% FINE ACC60    ;
 150:  WAIT    .10(sec) ;
 151:  R[27]=1    ;
 152:  CALL READ_SCORE    ;
 153:  R[27]=0    ;
 154:  IF R[57:CUR_SCORE]=0,JMP LBL[39] ;
 155:  IF R[25:PLACE_CNT_ERR]=2,JMP LBL[28] ;
 156:  R[22:RELEASE_CONSTANT]=R[22:RELEASE_CONSTANT]+.15    ;
 157:  R[25:PLACE_CNT_ERR]=R[25:PLACE_CNT_ERR]+1    ;
 158:  JMP LBL[25] ;
 159:   ;
 160:  LBL[28] ;
 161:  ! Put pin extraction code here. ;
 162:J PR[20] 100% CNT30 ACC70    ;
 163:J PR[12:RELEASE_ONE] 100% CNT30 ACC70    ;
 164:J PR[13:RELEASE_TWO] 100% CNT20 ACC70    ;
 165:  PR[14]=PR[13:RELEASE_TWO]    ;
 166:  PR[14,3]=PR[14,3]-17.8    ;
 167:L PR[14] 100mm/sec FINE    ;
 168:  WAIT    .05(sec) ;
 169:L PR[13:RELEASE_TWO] 100mm/sec FINE    ;
 170:  PR[14]=PR[13:RELEASE_TWO]    ;
 171:  PR[14,1]=PR[14,1]+4.097    ;
 172:  PR[14,2]=PR[14,2]+4.346    ;
 173:J PR[14] 100% FINE ACC50    ;
 174:  PR[14,3]=PR[14,3]-21.759    ;
 175:L PR[14] 100mm/sec FINE    ;
 176:  PR[14,3]=PR[14,3]+21.759    ;
 177:L PR[14] 100mm/sec FINE    ;
 178:J PR[12:RELEASE_ONE] 100% CNT20 ACC70    ;
 179:J PR[20] 100% CNT30 ACC70    ;
 180:  JMP LBL[38] ;
 181:   ;
 182:  LBL[39] ;
 183:  R[25:PLACE_CNT_ERR]=0    ;
 184:  JMP LBL[38] ;
 185:   ;
 186:  LBL[40] ;
 187:  R[28]=R[28]+1    ;
 188:  JMP LBL[38] ;
 189:   ;
 190:  LBL[41] ;
 191:  PAUSE ;
 192:  MESSAGE[NO PINS LEFT? or BROKEN PIN?] ;
 193:  JMP LBL[38] ;
 194:   ;
 195:  !!! CHECK REPO STATUS START ;
 196:  LBL[38] ;
 197:  R[22:RELEASE_CONSTANT]=20.2    ;
 198:  IF R[1:REPO_RCP_X]=22 AND R[2:REPO_RCP_Y]=20,JMP LBL[999] ;
 199:   ;
 200:  ! Not empty so update ;
 201:  R[1:REPO_RCP_X]=R[1:REPO_RCP_X]+1    ;
 202:  IF R[1:REPO_RCP_X]>22,JMP LBL[2] ;
 203:   ;
 204:  ! Update position x ;
 205:  PR[5,1:REPO_RCP_PSN]=PR[5,1:REPO_RCP_PSN]+R[3:REPO_RCP_UOFFSET]    ;
 206:  JMP LBL[1] ;
 207:   ;
 208:  ! Next row x overflow ;
 209:  LBL[2] ;
 210:  R[1:REPO_RCP_X]=1    ;
 211:  R[2:REPO_RCP_Y]=R[2:REPO_RCP_Y]+1    ;
 212:  PR[5,1:REPO_RCP_PSN]=PR[9,1:REPO_PSN]    ;
 213:  PR[5,2:REPO_RCP_PSN]=PR[5,2:REPO_RCP_PSN]-R[3:REPO_RCP_UOFFSET]    ;
 214:  JMP LBL[1] ;
 215:   ;
 216:  ! Switched from receptacle repo ;
 217:  ! to receptacle repo ;
 218:  LBL[999] ;
 219:  R[1:REPO_RCP_X]=1    ;
 220:  R[2:REPO_RCP_Y]=1    ;
 221:  IF R[4:REPO_X]=2 AND R[18:REPO_Y]=2,JMP LBL[996] ;
 222:   ;
 223:  R[4:REPO_X]=R[4:REPO_X]+1    ;
 224:  IF R[4:REPO_X]>2,JMP LBL[7] ;
 225:   ;
 226:  ! next repository column ;
 227:  PR[9,1:REPO_PSN]=PR[9,1:REPO_PSN]+R[19:REPO_XOFFSET]    ;
 228:  PR[9,2:REPO_PSN]=PR[9,2:REPO_PSN]-.05    ;
 229:  PR[5:REPO_RCP_PSN]=PR[9:REPO_PSN]    ;
 230:  JMP LBL[1] ;
 231:   ;
 232:  ! next repository row ;
 233:  LBL[7] ;
 234:  R[4:REPO_X]=1    ;
 235:  R[18:REPO_Y]=R[18:REPO_Y]+1    ;
 236:  PR[9,1:REPO_PSN]=PR[7,1:TMP_REPO_RCP]-.1    ;
 237:  PR[9,2:REPO_PSN]=PR[9,2:REPO_PSN]-R[20:REPO_YOFFSET]    ;
 238:  PR[5:REPO_RCP_PSN]=PR[9:REPO_PSN]    ;
 239:  JMP LBL[1] ;
 240:  !!! CHECK REPO STATUS END. ;
 241:   ;
 242:   ;
 243:   ;
 244:  !!! CHECK TO SEE CURRENT RECIPE S ;
 245:  LBL[1] ;
 246:  IF R[24:PICK_CNT_ERR]=2,JMP LBL[4] ;
 247:  IF R[25:PLACE_CNT_ERR]=2,JMP LBL[4] ;
 248:  R[11:RECIPE_IO_IDX]=R[11:RECIPE_IO_IDX]+1    ;
 249:  R[99:RECIPE_IDX]=R[99:RECIPE_IDX]+1    ;
 250:  R[8:MOD_RCP_X]=R[8:MOD_RCP_X]+1    ;
 251:   ;
 252:  IF R[8:MOD_RCP_X]>6,JMP LBL[5] ;
 253:   ;
 254:  PR[6,1:MOD_RCP_PSN]=PR[6,1:MOD_RCP_PSN]+R[6:MOD_RCP_XOFFSET]    ;
 255:  JMP LBL[4] ;
 256:   ;
 257:  LBL[5] ;
 258:  R[8:MOD_RCP_X]=1    ;
 259:  R[9:MOD_RCP_Y]=R[9:MOD_RCP_Y]+1    ;
 260:  PR[6,1:MOD_RCP_PSN]=PR[8,1:MOD_PSN]    ;
 261:  PR[6,2:MOD_RCP_PSN]=PR[6,2:MOD_RCP_PSN]-R[7:MOD_RCP_YOFFSET]    ;
 262:  JMP LBL[4] ;
 263:  !!! CHECK TO SEE CURRENT RECIPE ;
 264:  !!! END ;
 265:   ;
 266:   ;
 267:   ;
 268:  !!! MODULE FULL, CHECK STATUS ;
 269:  !!! START ;
 270:  LBL[998] ;
 271:  R[11:RECIPE_IO_IDX]=1    ;
 272:  R[99:RECIPE_IDX]=101    ;
 273:  R[8:MOD_RCP_X]=1    ;
 274:  R[9:MOD_RCP_Y]=1    ;
 275:   ;
 276:  ! Check to see if Ice Tray Full ;
 277:  IF R[5:MODULE_X]=6 AND R[15:MODULE_Y]=4,JMP LBL[997] ;
 278:   ;
 279:  ! Check if module row full ;
 280:  R[5:MODULE_X]=R[5:MODULE_X]+1    ;
 281:  IF R[5:MODULE_X]>6,JMP LBL[6] ;
 282:   ;
 283:  ! Increment module column ;
 284:  PR[8,1:MOD_PSN]=PR[8,1:MOD_PSN]+R[13:MODULE_XOFFSET]    ;
 285:  PR[6:MOD_RCP_PSN]=PR[8:MOD_PSN]    ;
 286:  JMP LBL[4] ;
 287:   ;
 288:  ! Increment module row and reset  ;
 289:  LBL[6] ;
 290:  R[5:MODULE_X]=1    ;
 291:  R[15:MODULE_Y]=R[15:MODULE_Y]+1    ;
 292:  PR[8,1:MOD_PSN]=PR[10,1:TMP_MOD_RCP]    ;
 293:  PR[8,2:MOD_PSN]=PR[8,2:MOD_PSN]-R[14:MODULE_YOFFSET]    ;
 294:  PR[6:MOD_RCP_PSN]=PR[8:MOD_PSN]    ;
 295:  JMP LBL[4] ;
 296:   ;
 297:  ! Switched from ice tray ;
 298:  ! to ice tray ;
 299:  LBL[997] ;
 300:  ! Check am I out of Ice Trays ;
 301:  IF R[16:ICE_TRAY_NUM]=2,JMP LBL[996] ;
 302:   ;
 303:  ! Increment Ice Tray and set mod ;
 304:  ! and mod_rcp equal ;
 305:  R[5:MODULE_X]=1    ;
 306:  R[15:MODULE_Y]=1    ;
 307:  R[16:ICE_TRAY_NUM]=R[16:ICE_TRAY_NUM]+1    ;
 308:  PR[11,2:ICE_TRAY_PSN]=PR[11,2:ICE_TRAY_PSN]-R[17:ICE_TRAY_YOFFSET]    ;
 309:  PR[8:MOD_PSN]=PR[11:ICE_TRAY_PSN]    ;
 310:  PR[6:MOD_RCP_PSN]=PR[8:MOD_PSN]    ;
 311:  JMP LBL[4] ;
 312:  !!! MODULE FULL, CHECK STATUS ;
 313:  !!! END ;
 314:   ;
 315:  LBL[996] ;
 316:  END ;
/POS
P[1:"DATUM"]{
   GP1:
	UF : 1, UT : 1,		CONFIG : 'L, 0, 0, 0',
	X =   424.654999  mm,	Y =   183.154999  mm,	Z =     0.000000  mm,
	W =  -180.000000 deg,	P =     0.000000 deg,	R =     0.000000 deg
};
P[2:"FIRST_PIN"]{
   GP1:
	UF : 1, UT : 1,		CONFIG : 'L, 0, 0, 0',
	X =   369.580994  mm,	Y =   174.535004  mm,	Z =     0.000000  mm,
	W =  -180.000000 deg,	P =     0.000000 deg,	R =     0.000000 deg
};
P[3:"CAMERA"]{
   GP1:
	UF : 1, UT : 1,		CONFIG : 'L, 0, 0, 0',
	X =   207.901993  mm,	Y =   332.035004  mm,	Z =    82.065002  mm,
	W =  -180.000000 deg,	P =     0.000000 deg,	R =     0.000000 deg
};
P[4:"FIRST_RCP"]{
   GP1:
	UF : 1, UT : 1,		CONFIG : 'L, 0, 0, 0',
	X =   108.552002  mm,	Y =   190.020996  mm,	Z =     0.000000  mm,
	W =  -180.000000 deg,	P =     0.000000 deg,	R =     0.000000 deg
};
/END
