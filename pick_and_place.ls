/PROG  PICK_AND_PLACE
/ATTR
OWNER		= MNEDITOR;
COMMENT		= "";
PROG_SIZE	= 6322;
CREATE		= DATE 26-07-31  TIME 11:56:56;
MODIFIED	= DATE 26-07-31  TIME 11:56:56;
FILE_NAME	= PICK_AND;
VERSION		= 0;
LINE_COUNT	= 292;
MEMORY_SIZE	= 6950;
PROTECT		= READ_WRITE;
TCD:  STACK_SIZE	= 0,
      TASK_PRIORITY	= 50,
      TIME_SLICE	= 0,
      BUSY_LAMP_OFF	= 0,
      ABORT_REQUEST	= 0,
      PAUSE_REQUEST	= 0;
DEFAULT_GROUP	= 1,*,*,*,*;
CONTROL_CODE	= 00000000 00000000;
LOCAL_REGISTERS	= 0,0,0;
/APPL
/APPL
/MN
   1:  ! Main driving loop ;
   2:  LBL[4:PP_LOOP] ;
   3:   ;
   4:  ! Reset Error Checking ;
   5:  R[24:PICK_CNT_ERR]=0    ;
   6:  R[25:PLACE_CNT_ERR]=0    ;
   7:   ;
   8:  ! Check for recipe reset ;
   9:  IF R[11:RECIPE_IO_IDX]=37,JMP LBL[998] ;
  10:  R[12:RECIPE_OUTPUT]=R[R[99]]    ;
  11:   ;
  12:  ! Checks next recipe output ;
  13:  IF R[12:RECIPE_OUTPUT]=0,JMP LBL[1] ;
  14:   ;
  15:  LBL[24] ;
  16:  ! get out of shroud safely ;
  17:J PR[20] 100% CNT30 ACC50    ;
  18:   ;
  19:  ! Move to next pin (FINE BEFORE) ;
  20:J PR[5:REPO_RCP_PSN] 100% CNT50 ACC50    ;
  21:   ;
  22:  ! Descend to grab pin ;
  23:  PR[2:TMP_REPO_RCP]=PR[5:REPO_RCP_PSN]    ;
  24:  PR[2,3:TMP_REPO_RCP]=PR[2,3:TMP_REPO_RCP]-R[21:PICKUP_CONSTANT]    ;
  25:L PR[2:TMP_REPO_RCP] 100mm/sec FINE    ;
  26:   ;
  27:  ! Ascend with Pin ;
  28:L PR[5:REPO_RCP_PSN] 100mm/sec FINE    ;
  29:   ;
  30:  ! Move safely to shroud ;
  31:  PR[20]=PR[5:REPO_RCP_PSN]    ;
  32:  PR[20,3]=PR[3,3:TMP_CAMERA]    ;
  33:  PR[20,1]=PR[3,1:TMP_CAMERA]-25    ;
  34:  ! (FINE BEFORE) ;
  35:J PR[20] 100% CNT25 ACC70    ;
  36:J PR[3:TMP_CAMERA] 100% FINE ACC50    ;
  37:  WAIT    .50(sec) ;
  38:   ;
  39:   ;
  40:   ;
  41:  ! initiate camera code ;
  42:  R[50:STEP_CNT]=0    ;
  43:  R[51:MAX_STEP_CNT]=74    ;
  44:  R[52:TURN_PER_STEP]=10    ;
  45:  R[53:MINIMUM_THRESH]=75    ;
  46:  R[54:ABOVE_THRESH]=0    ;
  47:  R[55:BEST_SCORE]=0    ;
  48:  R[56:DOWN_THRESH]=15    ;
  49:  R[57:CUR_SCORE]=0    ;
  50:  R[58:CUR_DROP]=0    ;
  51:  R[59]=37    ;
  52:  PR[21]=PR[3:TMP_CAMERA]    ;
  53:  PR[22]=PR[3:TMP_CAMERA]    ;
  54:   ;
  55:  R[27]=1    ;
  56:  CALL READ_SCORE    ;
  57:  R[27]=0    ;
  58:  IF R[57:CUR_SCORE]>0,JMP LBL[30] ;
  59:  MESSAGE[FAILED PICK] ;
  60:  IF R[24:PICK_CNT_ERR]=2,JMP LBL[38] ;
  61:  R[24:PICK_CNT_ERR]=R[24:PICK_CNT_ERR]+1    ;
  62:  JMP LBL[24] ;
  63:   ;
  64:  ! FIND BEST ORIENTATION ;
  65:  ! Rotate to next step ;
  66:  LBL[30] ;
  67:  R[24:PICK_CNT_ERR]=0    ;
  68:L PR[21] 2000deg/sec FINE    ;
  69:  WAIT    .05(sec) ;
  70:  CALL READ_SCORE    ;
  71:  IF R[57:CUR_SCORE]>R[55:BEST_SCORE],JMP LBL[31] ;
  72:  IF R[54:ABOVE_THRESH]=1,JMP LBL[33] ;
  73:  JMP LBL[34] ;
  74:   ;
  75:  ! Entered quality threshold ;
  76:  LBL[31] ;
  77:  R[55:BEST_SCORE]=R[57:CUR_SCORE]    ;
  78:  PR[22]=PR[21]    ;
  79:  IF R[57:CUR_SCORE]>R[53:MINIMUM_THRESH],JMP LBL[32] ;
  80:  JMP LBL[34] ;
  81:   ;
  82:  ! In quality threshold - NEW BEST ;
  83:  LBL[32] ;
  84:  R[54:ABOVE_THRESH]=1    ;
  85:  JMP LBL[34] ;
  86:   ;
  87:  ! Significant downturn check ;
  88:  LBL[33] ;
  89:  R[58:CUR_DROP]=R[55:BEST_SCORE]-R[57:CUR_SCORE]    ;
  90:  IF R[58:CUR_DROP]>R[56:DOWN_THRESH],JMP LBL[35] ;
  91:  JMP LBL[34] ;
  92:   ;
  93:  ! Iterate and call next step ;
  94:  LBL[34] ;
  95:  R[50:STEP_CNT]=R[50:STEP_CNT]+1    ;
  96:  IF R[50:STEP_CNT]<>R[59],JMP LBL[63] ;
  97:  PR[21,6]=PR[21,6]+5    ;
  98:  LBL[63] ;
  99:  IF R[50:STEP_CNT]>R[51:MAX_STEP_CNT],JMP LBL[37] ;
 100:  IF R[50:STEP_CNT]>R[59],JMP LBL[64] ;
 101:  PR[21,6]=PR[21,6]+R[52:TURN_PER_STEP]    ;
 102:  JMP LBL[30] ;
 103:  LBL[64] ;
 104:  PR[21,6]=PR[21,6]-R[52:TURN_PER_STEP]    ;
 105:  JMP LBL[30] ;
 106:   ;
 107:  ! Found Peak or no match ;
 108:  LBL[35] ;
 109:J PR[22] 100% CNT100 ACC70    ;
 110:  JMP LBL[36] ;
 111:   ;
 112:  ! Fail Case: No Match ;
 113:  LBL[37] ;
 114:  MESSAGE[NO HIGH MATCH] ;
 115:  R[26:FAILED_PICK_CNT]=R[26:FAILED_PICK_CNT]+1    ;
 116:J PR[22] 100% CNT100 ACC70    ;
 117:  JMP LBL[36] ;
 118:   ;
 119:  ! Done (don't forget to maintain ;
 120:  ! rotation values ;
 121:  LBL[36] ;
 122:  PR[6,6:MOD_RCP_PSN]=PR[22,6]    ;
 123:   ;
 124:  ! Move out of shroud ;
 125:  PR[20]=PR[3:TMP_CAMERA]    ;
 126:  PR[20,1]=PR[20,1]-25    ;
 127:  PR[20,2]=PR[20,2]-R[23:Y_OFFSET_SHROUD]    ;
 128:  PR[20,6]=PR[22,6]    ;
 129:  LBL[25] ;
 130:J PR[20] 100% CNT30 ACC50    ;
 131:   ;
 132:  ! Move to Cable Module (BEFORE FI ;
 133:J PR[6:MOD_RCP_PSN] 100% CNT10 ACC70    ;
 134:   ;
 135:  ! Descend with receptacle ;
 136:  PR[4:TMP_MOD_RCP]=PR[6:MOD_RCP_PSN]    ;
 137:  PR[4,3:TMP_MOD_RCP]=PR[4,3:TMP_MOD_RCP]-R[22:RELEASE_CONSTANT]    ;
 138:L PR[4:TMP_MOD_RCP] 100mm/sec FINE    ;
 139:   ;
 140:  ! Ascend without receptacle ;
 141:L PR[6:MOD_RCP_PSN] 100mm/sec FINE    ;
 142:  ! Move safely back to shroud ;
 143:J PR[20] 100% CNT30 ACC70    ;
 144:  ! Check without receptacle ;
 145:  R[57:CUR_SCORE]=0    ;
 146:J PR[22] 100% FINE ACC70    ;
 147:  WAIT    .50(sec) ;
 148:  R[27]=1    ;
 149:  CALL READ_SCORE    ;
 150:  R[27]=0    ;
 151:  IF R[57:CUR_SCORE]=0,JMP LBL[39] ;
 152:  IF R[25:PLACE_CNT_ERR]=2,JMP LBL[28] ;
 153:  R[22:RELEASE_CONSTANT]=R[22:RELEASE_CONSTANT]+.1    ;
 154:  R[25:PLACE_CNT_ERR]=R[25:PLACE_CNT_ERR]+1    ;
 155:  JMP LBL[25] ;
 156:   ;
 157:  LBL[28] ;
 158:  ! Put pin extraction code here. ;
 159:J PR[20] 100% CNT30 ACC70    ;
 160:J PR[12:RELEASE_ONE] 100% CNT30 ACC70    ;
 161:J PR[13:RELEASE_TWO] 100% CNT30 ACC70    ;
 162:  MESSAGE[PLACE FAILED CLEAR PART RESUME] ;
 163:  PAUSE ;
 164:J PR[12:RELEASE_ONE] 100% CNT30 ACC70    ;
 165:J PR[20] 100% CNT30 ACC70    ;
 166:  JMP LBL[38] ;
 167:   ;
 168:  LBL[39] ;
 169:  R[25:PLACE_CNT_ERR]=0    ;
 170:   ;
 171:  !!! CHECK REPO STATUS START ;
 172:  LBL[38] ;
 173:  R[22:RELEASE_CONSTANT]=20.2    ;
 174:  IF R[1:REPO_RCP_X]=22 AND R[2:REPO_RCP_Y]=20,JMP LBL[999] ;
 175:   ;
 176:  ! Not empty so update ;
 177:  R[1:REPO_RCP_X]=R[1:REPO_RCP_X]+1    ;
 178:  IF R[1:REPO_RCP_X]>22,JMP LBL[2] ;
 179:   ;
 180:  ! Update position x ;
 181:  PR[5,1:REPO_RCP_PSN]=PR[5,1:REPO_RCP_PSN]+R[3:REPO_RCP_UOFFSET]    ;
 182:  JMP LBL[1] ;
 183:   ;
 184:  ! Next row x overflow ;
 185:  LBL[2] ;
 186:  R[1:REPO_RCP_X]=1    ;
 187:  R[2:REPO_RCP_Y]=R[2:REPO_RCP_Y]+1    ;
 188:  PR[5,1:REPO_RCP_PSN]=PR[9,1:REPO_PSN]    ;
 189:  PR[5,2:REPO_RCP_PSN]=PR[5,2:REPO_RCP_PSN]-R[3:REPO_RCP_UOFFSET]    ;
 190:  JMP LBL[1] ;
 191:   ;
 192:  ! Switched from receptacle repo ;
 193:  ! to receptacle repo ;
 194:  LBL[999] ;
 195:  R[1:REPO_RCP_X]=1    ;
 196:  R[2:REPO_RCP_Y]=1    ;
 197:  IF R[4:REPO_X]=2 AND R[18:REPO_Y]=2,JMP LBL[996] ;
 198:   ;
 199:  R[4:REPO_X]=R[4:REPO_X]+1    ;
 200:  IF R[4:REPO_X]>2,JMP LBL[7] ;
 201:   ;
 202:  ! next repository column ;
 203:  PR[9,1:REPO_PSN]=PR[9,1:REPO_PSN]+R[19:REPO_XOFFSET]    ;
 204:  PR[9,2:REPO_PSN]=PR[9,2:REPO_PSN]-.05    ;
 205:  PR[5:REPO_RCP_PSN]=PR[9:REPO_PSN]    ;
 206:  JMP LBL[1] ;
 207:   ;
 208:  ! next repository row ;
 209:  LBL[7] ;
 210:  R[4:REPO_X]=1    ;
 211:  R[18:REPO_Y]=R[18:REPO_Y]+1    ;
 212:  PR[9,1:REPO_PSN]=PR[7,1:TMP_REPO_RCP]-.1    ;
 213:  PR[9,2:REPO_PSN]=PR[9,2:REPO_PSN]-R[20:REPO_YOFFSET]    ;
 214:  PR[5:REPO_RCP_PSN]=PR[9:REPO_PSN]    ;
 215:  JMP LBL[1] ;
 216:  !!! CHECK REPO STATUS END. ;
 217:   ;
 218:   ;
 219:   ;
 220:  !!! CHECK TO SEE CURRENT RECIPE S ;
 221:  LBL[1] ;
 222:  IF R[24:PICK_CNT_ERR]=2,JMP LBL[4] ;
 223:  IF R[25:PLACE_CNT_ERR]=2,JMP LBL[4] ;
 224:  R[11:RECIPE_IO_IDX]=R[11:RECIPE_IO_IDX]+1    ;
 225:  R[99:RECIPE_IDX]=R[99:RECIPE_IDX]+1    ;
 226:  R[8:MOD_RCP_X]=R[8:MOD_RCP_X]+1    ;
 227:   ;
 228:  IF R[8:MOD_RCP_X]>6,JMP LBL[5] ;
 229:   ;
 230:  PR[6,1:MOD_RCP_PSN]=PR[6,1:MOD_RCP_PSN]+R[6:MOD_RCP_XOFFSET]    ;
 231:  JMP LBL[4] ;
 232:   ;
 233:  LBL[5] ;
 234:  R[8:MOD_RCP_X]=1    ;
 235:  R[9:MOD_RCP_Y]=R[9:MOD_RCP_Y]+1    ;
 236:  PR[6,1:MOD_RCP_PSN]=PR[8,1:MOD_PSN]    ;
 237:  PR[6,2:MOD_RCP_PSN]=PR[6,2:MOD_RCP_PSN]-R[7:MOD_RCP_YOFFSET]    ;
 238:  JMP LBL[4] ;
 239:  !!! CHECK TO SEE CURRENT RECIPE ;
 240:  !!! END ;
 241:   ;
 242:   ;
 243:   ;
 244:  !!! MODULE FULL, CHECK STATUS ;
 245:  !!! START ;
 246:  LBL[998] ;
 247:  R[11:RECIPE_IO_IDX]=1    ;
 248:  R[99:RECIPE_IDX]=101    ;
 249:  R[8:MOD_RCP_X]=1    ;
 250:  R[9:MOD_RCP_Y]=1    ;
 251:   ;
 252:  ! Check to see if Ice Tray Full ;
 253:  IF R[5:MODULE_X]=6 AND R[15:MODULE_Y]=4,JMP LBL[997] ;
 254:   ;
 255:  ! Check if module row full ;
 256:  R[5:MODULE_X]=R[5:MODULE_X]+1    ;
 257:  IF R[5:MODULE_X]>6,JMP LBL[6] ;
 258:   ;
 259:  ! Increment module column ;
 260:  PR[8,1:MOD_PSN]=PR[8,1:MOD_PSN]+R[13:MODULE_XOFFSET]    ;
 261:  PR[6:MOD_RCP_PSN]=PR[8:MOD_PSN]    ;
 262:  JMP LBL[4] ;
 263:   ;
 264:  ! Increment module row and reset  ;
 265:  LBL[6] ;
 266:  R[5:MODULE_X]=1    ;
 267:  R[15:MODULE_Y]=R[15:MODULE_Y]+1    ;
 268:  PR[8,1:MOD_PSN]=PR[10,1:TMP_MOD_RCP]    ;
 269:  PR[8,2:MOD_PSN]=PR[8,2:MOD_PSN]-R[14:MODULE_YOFFSET]    ;
 270:  PR[6:MOD_RCP_PSN]=PR[8:MOD_PSN]    ;
 271:  JMP LBL[4] ;
 272:   ;
 273:  ! Switched from ice tray ;
 274:  ! to ice tray ;
 275:  LBL[997] ;
 276:  ! Check am I out of Ice Trays ;
 277:  IF R[16:ICE_TRAY_NUM]=2,JMP LBL[996] ;
 278:   ;
 279:  ! Increment Ice Tray and set mod ;
 280:  ! and mod_rcp equal ;
 281:  R[5:MODULE_X]=1    ;
 282:  R[15:MODULE_Y]=1    ;
 283:  R[16:ICE_TRAY_NUM]=R[16:ICE_TRAY_NUM]+1    ;
 284:  PR[11,2:ICE_TRAY_PSN]=PR[11,2:ICE_TRAY_PSN]-R[17:ICE_TRAY_YOFFSET]    ;
 285:  PR[8:MOD_PSN]=PR[11:ICE_TRAY_PSN]    ;
 286:  PR[6:MOD_RCP_PSN]=PR[8:MOD_PSN]    ;
 287:  JMP LBL[4] ;
 288:  !!! MODULE FULL, CHECK STATUS ;
 289:  !!! END ;
 290:   ;
 291:  LBL[996] ;
 292:  END ;
/POS
P[1:"DATUM"]{
   GP1:
	UF : 1, UT : 1,		CONFIG : 'L, 0, 0, 0',
	X =   424.654999  mm,	Y =   183.154999  mm,	Z =     0.000000  mm,
	W =  -180.000000 deg,	P =     0.000000 deg,	R =     0.000000 deg
};
P[2:"FIRST_PIN"]{
   GP1:
	UF : 1, UT : 1,		CONFIG : 'L, 0, 0, 0',
	X =   369.580994  mm,	Y =   174.535004  mm,	Z =     0.000000  mm,
	W =  -180.000000 deg,	P =     0.000000 deg,	R =     0.000000 deg
};
P[3:"CAMERA"]{
   GP1:
	UF : 1, UT : 1,		CONFIG : 'L, 0, 0, 0',
	X =   207.901993  mm,	Y =   332.035004  mm,	Z =    82.065002  mm,
	W =  -180.000000 deg,	P =     0.000000 deg,	R =     0.000000 deg
};
P[4:"FIRST_RCP"]{
   GP1:
	UF : 1, UT : 1,		CONFIG : 'L, 0, 0, 0',
	X =   108.552002  mm,	Y =   190.020996  mm,	Z =     0.000000  mm,
	W =  -180.000000 deg,	P =     0.000000 deg,	R =     0.000000 deg
};
/END
