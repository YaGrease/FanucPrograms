/PROG  PICK_AND_PLACE
/ATTR
OWNER		= MNEDITOR;
COMMENT		= "";
PROG_SIZE	= 7920;
CREATE		= DATE 26-08-17  TIME 16:54:00;
MODIFIED	= DATE 26-08-17  TIME 16:54:00;
FILE_NAME	= PICK_AND;
VERSION		= 0;
LINE_COUNT	= 360;
MEMORY_SIZE	= 8532;
PROTECT		= READ_WRITE;
TCD:  STACK_SIZE	= 0,
      TASK_PRIORITY	= 50,
      TIME_SLICE	= 0,
      BUSY_LAMP_OFF	= 0,
      ABORT_REQUEST	= 0,
      PAUSE_REQUEST	= 0;
DEFAULT_GROUP	= 1,*,*,*,*;
CONTROL_CODE	= 00000000 00000000;
LOCAL_REGISTERS	= 0,0,0;
/APPL
/APPL
/MN
   1:  ! PICK_AND_PLACE ;
   2:   ;
   3:  ! Main driving loop ;
   4:  LBL[4:PP_LOOP] ;
   5:   ;
   6:  ! Reset error checking values ;
   7:  R[24:PICK_CNT_ERR]=0    ;
   8:  R[25:PLACE_CNT_ERR]=0    ;
   9:   ;
  10:  ! Check current recipe completion ;
  11:  ! otherwise continues to next val ;
  12:  IF R[11:RECIPE_IO_IDX]=37,JMP LBL[998] ;
  13:  R[12:RECIPE_OUTPUT]=R[R[99]]    ;
  14:  IF R[12:RECIPE_OUTPUT]=0,JMP LBL[1] ;
  15:   ;
  16:  ! Move from camera location to ;
  17:  ! receptacle repository ;
  18:  LBL[24] ;
  19:J PR[20] 100% CNT30 ACC50    ;
  20:J PR[5:REPO_RCP_PSN] 100% CNT50 ACC65    ;
  21:   ;
  22:  ! Pickup of receptacle ;
  23:  PR[2:TMP_REPO_RCP]=PR[5:REPO_RCP_PSN]    ;
  24:  PR[2,3:TMP_REPO_RCP]=PR[2,3:TMP_REPO_RCP]-R[21:PICKUP_CONSTANT]    ;
  25:L PR[2:TMP_REPO_RCP] 100mm/sec FINE    ;
  26:L PR[5:REPO_RCP_PSN] 100mm/sec FINE    ;
  27:   ;
  28:  ! Move from receptacle repository ;
  29:  ! to camera location ;
  30:  PR[20]=PR[5:REPO_RCP_PSN]    ;
  31:  PR[20,3]=PR[3,3:TMP_CAMERA]    ;
  32:  PR[20,1]=PR[3,1:TMP_CAMERA]-25    ;
  33:J PR[20] 100% CNT25 ACC70    ;
  34:J PR[3:TMP_CAMERA] 100% FINE ACC50    ;
  35:   ;
  36:  ! Initiate camera code for search ;
  37:  ! algorithm ;
  38:  R[50:STEP_CNT]=0    ;
  39:  R[51:MAX_STEP_CNT]=92    ;
  40:  R[52:TURN_PER_STEP]=8    ;
  41:  R[53:MINIMUM_THRESH]=83    ;
  42:  R[54:ABOVE_THRESH]=0    ;
  43:  R[55:BEST_SCORE]=0    ;
  44:  R[56:DOWN_THRESH]=3    ;
  45:  R[57:CUR_SCORE]=0    ;
  46:  R[58:CUR_DROP]=0    ;
  47:  R[59]=46    ;
  48:  PR[21]=PR[3:TMP_CAMERA]    ;
  49:  PR[22]=PR[3:TMP_CAMERA]    ;
  50:   ;
  51:  ! Check if a receptacle was ;
  52:  ! successfully picked up ;
  53:  WAIT    .05(sec) ;
  54:  R[27:CAMERA_MODE]=1    ;
  55:  CALL READ_SCORE    ;
  56:  R[27:CAMERA_MODE]=0    ;
  57:  IF R[57:CUR_SCORE]>0,JMP LBL[30] ;
  58:  MESSAGE[FAILED PICK] ;
  59:  IF R[24:PICK_CNT_ERR]=2,JMP LBL[40] ;
  60:  R[24:PICK_CNT_ERR]=R[24:PICK_CNT_ERR]+1    ;
  61:  IF R[28]=2,JMP LBL[41] ;
  62:  JMP LBL[24] ;
  63:   ;
  64:  ! FIND BEST ORIENTATION ALGO ;
  65:  ! Rotate to next orientation ;
  66:  LBL[30] ;
  67:  R[28]=0    ;
  68:  R[24:PICK_CNT_ERR]=0    ;
  69:L PR[21] 2000deg/sec FINE    ;
  70:  WAIT    .05(sec) ;
  71:  CALL READ_SCORE    ;
  72:  IF R[57:CUR_SCORE]>R[55:BEST_SCORE],JMP LBL[31] ;
  73:  IF R[54:ABOVE_THRESH]=1,JMP LBL[33] ;
  74:  JMP LBL[34] ;
  75:   ;
  76:  ! Highest score so far ;
  77:  LBL[31] ;
  78:  R[55:BEST_SCORE]=R[57:CUR_SCORE]    ;
  79:  PR[22]=PR[21]    ;
  80:  IF R[57:CUR_SCORE]>R[53:MINIMUM_THRESH],JMP LBL[32] ;
  81:  JMP LBL[34] ;
  82:   ;
  83:  ! Above quality threshold ;
  84:  LBL[32] ;
  85:  R[54:ABOVE_THRESH]=1    ;
  86:  JMP LBL[34] ;
  87:   ;
  88:  ! Significant downturn check ;
  89:  ! for early exit ;
  90:  LBL[33] ;
  91:  R[58:CUR_DROP]=R[55:BEST_SCORE]-R[57:CUR_SCORE]    ;
  92:  IF R[58:CUR_DROP]>R[56:DOWN_THRESH],JMP LBL[35] ;
  93:  JMP LBL[34] ;
  94:   ;
  95:  ! Iterate values for next ;
  96:  ! orientation ;
  97:  LBL[34] ;
  98:  R[50:STEP_CNT]=R[50:STEP_CNT]+1    ;
  99:  IF R[50:STEP_CNT]<>R[59],JMP LBL[63] ;
 100:  PR[21,6]=PR[21,6]+4    ;
 101:  LBL[63] ;
 102:  IF R[50:STEP_CNT]>R[51:MAX_STEP_CNT],JMP LBL[37] ;
 103:  IF R[50:STEP_CNT]>R[59],JMP LBL[64] ;
 104:  PR[21,6]=PR[21,6]+R[52:TURN_PER_STEP]    ;
 105:  JMP LBL[30] ;
 106:  LBL[64] ;
 107:  PR[21,6]=PR[21,6]-R[52:TURN_PER_STEP]    ;
 108:  JMP LBL[30] ;
 109:   ;
 110:  ! Found high score ;
 111:  LBL[35] ;
 112:J PR[22] 100% CNT100 ACC70    ;
 113:  JMP LBL[36] ;
 114:   ;
 115:  ! Fail Case: No Match ;
 116:  LBL[37] ;
 117:  MESSAGE[NO CORRECT ORIENTATION FOUND] ;
 118:  R[26:FAILED_PICK_CNT]=R[26:FAILED_PICK_CNT]+1    ;
 119:J PR[22] 100% CNT100 ACC70    ;
 120:  JMP LBL[36] ;
 121:   ;
 122:  ! Maintain rotation values ;
 123:  LBL[36] ;
 124:  PR[6,6:MOD_RCP_PSN]=PR[22,6]    ;
 125:   ;
 126:  ! Move from Camera location ;
 127:  ! to module ;
 128:  PR[20]=PR[3:TMP_CAMERA]    ;
 129:  PR[20,1]=PR[20,1]-25    ;
 130:  PR[20,2]=PR[20,2]-R[23:Y_OFFSET_SHROUD]    ;
 131:  PR[20,6]=PR[22,6]    ;
 132:  LBL[25] ;
 133:J PR[20] 100% CNT30 ACC50    ;
 134:J PR[6:MOD_RCP_PSN] 100% CNT10 ACC70    ;
 135:   ;
 136:  ! Place the receptacle ;
 137:  PR[4:TMP_MOD_RCP]=PR[6:MOD_RCP_PSN]    ;
 138:  PR[4,3:TMP_MOD_RCP]=PR[4,3:TMP_MOD_RCP]-R[22:RELEASE_CONSTANT]    ;
 139:L PR[4:TMP_MOD_RCP] 100mm/sec FINE    ;
 140:  WAIT    .10(sec) ;
 141:L PR[6:MOD_RCP_PSN] 100mm/sec FINE    ;
 142:   ;
 143:  ! Move from the module back ;
 144:  ! to the camera location ;
 145:J PR[20] 100% CNT30 ACC70    ;
 146:  R[57:CUR_SCORE]=0    ;
 147:J PR[22] 100% FINE ACC60    ;
 148:   ;
 149:  ! Check tool to see if it ;
 150:  ! successfully removed the ;
 151:  ! receptacle ;
 152:  WAIT    .10(sec) ;
 153:  R[27:CAMERA_MODE]=1    ;
 154:  CALL READ_SCORE    ;
 155:  R[27:CAMERA_MODE]=0    ;
 156:  IF R[57:CUR_SCORE]=0,JMP LBL[39] ;
 157:  IF R[25:PLACE_CNT_ERR]=2,JMP LBL[28] ;
 158:  R[22:RELEASE_CONSTANT]=R[22:RELEASE_CONSTANT]+.15    ;
 159:  R[25:PLACE_CNT_ERR]=R[25:PLACE_CNT_ERR]+1    ;
 160:  JMP LBL[25] ;
 161:   ;
 162:  ! ERROR failed to remove ;
 163:  ! receptacle go to ;
 164:  ! extraction ;
 165:  LBL[28] ;
 166:J PR[20] 100% CNT30 ACC70    ;
 167:J PR[12:RELEASE_ONE] 100% CNT30 ACC70    ;
 168:J PR[13:RELEASE_TWO] 100% CNT20 ACC70    ;
 169:  PR[14]=PR[13:RELEASE_TWO]    ;
 170:  PR[14,3]=PR[14,3]-17.8    ;
 171:L PR[14] 100mm/sec FINE    ;
 172:  WAIT    .05(sec) ;
 173:L PR[13:RELEASE_TWO] 100mm/sec FINE    ;
 174:  PR[14]=PR[13:RELEASE_TWO]    ;
 175:  PR[14,1]=PR[14,1]+4.097    ;
 176:  PR[14,2]=PR[14,2]+4.346    ;
 177:J PR[14] 100% FINE ACC50    ;
 178:  PR[14,3]=PR[14,3]-21.759    ;
 179:L PR[14] 100mm/sec FINE    ;
 180:  PR[14,3]=PR[14,3]+21.759    ;
 181:L PR[14] 100mm/sec FINE    ;
 182:J PR[12:RELEASE_ONE] 100% CNT20 ACC70    ;
 183:J PR[20] 100% CNT30 ACC70    ;
 184:  JMP LBL[38] ;
 185:   ;
 186:  ! No receptacle found as ;
 187:  ! expected clear errors ;
 188:  LBL[39] ;
 189:  R[25:PLACE_CNT_ERR]=0    ;
 190:  JMP LBL[38] ;
 191:   ;
 192:  ! Receptacle was found ;
 193:  ! when not expected try ;
 194:  ! again ;
 195:  LBL[40] ;
 196:  R[28]=R[28]+1    ;
 197:  JMP LBL[38] ;
 198:   ;
 199:  ! After multiple tries there ;
 200:  ! is still a receptacle needs ;
 201:  ! human intervention to clear ;
 202:  LBL[41] ;
 203:  MESSAGE[NO PINS LEFT? OR DAMAGED PIN?] ;
 204:  PAUSE ;
 205:  JMP LBL[38] ;
 206:   ;
 207:  !!! CHECK REPO STATUS START ;
 208:  LBL[38] ;
 209:   ;
 210:  ! Reset place constant as a ;
 211:  ! successful place occurred ;
 212:  R[22:RELEASE_CONSTANT]=20.2    ;
 213:   ;
 214:  ! Check if repository empty ;
 215:  IF R[1:REPO_RCP_X]=22 AND R[2:REPO_RCP_Y]=20,JMP LBL[999] ;
 216:   ;
 217:  ! Check whether to increment ;
 218:  ! X or Y ;
 219:  R[1:REPO_RCP_X]=R[1:REPO_RCP_X]+1    ;
 220:  IF R[1:REPO_RCP_X]>22,JMP LBL[2] ;
 221:   ;
 222:  ! Increment row (X) position ;
 223:  PR[5,1:REPO_RCP_PSN]=PR[5,1:REPO_RCP_PSN]+R[3:REPO_RCP_UOFFSET]    ;
 224:  JMP LBL[1] ;
 225:   ;
 226:  ! Increment column (Y) ;
 227:  ! position ;
 228:  LBL[2] ;
 229:  R[1:REPO_RCP_X]=1    ;
 230:  R[2:REPO_RCP_Y]=R[2:REPO_RCP_Y]+1    ;
 231:  PR[5,1:REPO_RCP_PSN]=PR[9,1:REPO_PSN]    ;
 232:  PR[5,2:REPO_RCP_PSN]=PR[5,2:REPO_RCP_PSN]-R[3:REPO_RCP_UOFFSET]    ;
 233:  JMP LBL[1] ;
 234:   ;
 235:  ! Switching receptacle repository ;
 236:  LBL[999] ;
 237:   ;
 238:  ! Reset X and Y for new ;
 239:  ! repository ;
 240:  R[1:REPO_RCP_X]=1    ;
 241:  R[2:REPO_RCP_Y]=1    ;
 242:   ;
 243:  ! Check if all repositories are ;
 244:  ! empty ;
 245:  IF R[4:REPO_X]=2 AND R[18:REPO_Y]=2,JMP LBL[996] ;
 246:   ;
 247:  ! Check whether to increment ;
 248:  ! X or Y ;
 249:  R[4:REPO_X]=R[4:REPO_X]+1    ;
 250:  IF R[4:REPO_X]>2,JMP LBL[7] ;
 251:   ;
 252:  ! Increment repository row (X) ;
 253:  PR[9,1:REPO_PSN]=PR[9,1:REPO_PSN]+R[19:REPO_XOFFSET]    ;
 254:  PR[9,2:REPO_PSN]=PR[9,2:REPO_PSN]-.05    ;
 255:  PR[5:REPO_RCP_PSN]=PR[9:REPO_PSN]    ;
 256:  JMP LBL[1] ;
 257:   ;
 258:  ! Increment repository ;
 259:  ! column (Y) ;
 260:  LBL[7] ;
 261:  R[4:REPO_X]=1    ;
 262:  R[18:REPO_Y]=R[18:REPO_Y]+1    ;
 263:  PR[9,1:REPO_PSN]=PR[7,1:TMP_REPO_RCP]-.1    ;
 264:  PR[9,2:REPO_PSN]=PR[9,2:REPO_PSN]-R[20:REPO_YOFFSET]    ;
 265:  PR[5:REPO_RCP_PSN]=PR[9:REPO_PSN]    ;
 266:  JMP LBL[1] ;
 267:  !!! CHECK REPO STATUS END. ;
 268:   ;
 269:   ;
 270:   ;
 271:  !!! CHECK CURRENT MODULE START ;
 272:  LBL[1] ;
 273:   ;
 274:  ! Handle error cases for pick ;
 275:  ! and place ;
 276:  IF R[24:PICK_CNT_ERR]=2,JMP LBL[4] ;
 277:  IF R[25:PLACE_CNT_ERR]=2,JMP LBL[4] ;
 278:   ;
 279:  ! Increment values to advance ;
 280:  ! module recipe ;
 281:  R[11:RECIPE_IO_IDX]=R[11:RECIPE_IO_IDX]+1    ;
 282:  R[99:RECIPE_IDX]=R[99:RECIPE_IDX]+1    ;
 283:  R[8:MOD_RCP_X]=R[8:MOD_RCP_X]+1    ;
 284:   ;
 285:  ! Check whether to increment ;
 286:  ! X or Y ;
 287:  IF R[8:MOD_RCP_X]>6,JMP LBL[5] ;
 288:   ;
 289:  ! Increment row (X) in module ;
 290:  PR[6,1:MOD_RCP_PSN]=PR[6,1:MOD_RCP_PSN]+R[6:MOD_RCP_XOFFSET]    ;
 291:  JMP LBL[4] ;
 292:   ;
 293:  ! Increment column (Y) in ;
 294:  ! module ;
 295:  LBL[5] ;
 296:  R[8:MOD_RCP_X]=1    ;
 297:  R[9:MOD_RCP_Y]=R[9:MOD_RCP_Y]+1    ;
 298:  PR[6,1:MOD_RCP_PSN]=PR[8,1:MOD_PSN]    ;
 299:  PR[6,2:MOD_RCP_PSN]=PR[6,2:MOD_RCP_PSN]-R[7:MOD_RCP_YOFFSET]    ;
 300:  JMP LBL[4] ;
 301:  !!! CHECK TO SEE CURRENT RECIPE ;
 302:  !!! END ;
 303:   ;
 304:   ;
 305:   ;
 306:  !!! MODULE FULL, CHECK STATUS ;
 307:  !!! START ;
 308:  LBL[998] ;
 309:   ;
 310:  ! Re-initialize module values ;
 311:  ! for new module ;
 312:  R[11:RECIPE_IO_IDX]=1    ;
 313:  R[99:RECIPE_IDX]=101    ;
 314:  R[8:MOD_RCP_X]=1    ;
 315:  R[9:MOD_RCP_Y]=1    ;
 316:   ;
 317:  ! Check if ice tray full ;
 318:  IF R[5:MODULE_X]=6 AND R[15:MODULE_Y]=4,JMP LBL[997] ;
 319:   ;
 320:  ! Check whether to increment ;
 321:  ! X or Y ;
 322:  R[5:MODULE_X]=R[5:MODULE_X]+1    ;
 323:  IF R[5:MODULE_X]>6,JMP LBL[6] ;
 324:   ;
 325:  ! Increment module row (X) ;
 326:  PR[8,1:MOD_PSN]=PR[8,1:MOD_PSN]+R[13:MODULE_XOFFSET]    ;
 327:  PR[6:MOD_RCP_PSN]=PR[8:MOD_PSN]    ;
 328:  JMP LBL[4] ;
 329:   ;
 330:  ! Increment module column ;
 331:  ! (Y) ;
 332:  LBL[6] ;
 333:  R[5:MODULE_X]=1    ;
 334:  R[15:MODULE_Y]=R[15:MODULE_Y]+1    ;
 335:  PR[8,1:MOD_PSN]=PR[10,1:TMP_MOD_RCP]    ;
 336:  PR[8,2:MOD_PSN]=PR[8,2:MOD_PSN]-R[14:MODULE_YOFFSET]    ;
 337:  PR[6:MOD_RCP_PSN]=PR[8:MOD_PSN]    ;
 338:  JMP LBL[4] ;
 339:   ;
 340:  ! Switched from ice trays ;
 341:  LBL[997] ;
 342:   ;
 343:  ! Check if ice trays completely ;
 344:  ! full ;
 345:  IF R[16:ICE_TRAY_NUM]=2,JMP LBL[996] ;
 346:   ;
 347:  ! Increment Ice Tray and set mod ;
 348:  ! and mod_rcp equal ;
 349:  R[5:MODULE_X]=1    ;
 350:  R[15:MODULE_Y]=1    ;
 351:  R[16:ICE_TRAY_NUM]=R[16:ICE_TRAY_NUM]+1    ;
 352:  PR[11,2:ICE_TRAY_PSN]=PR[11,2:ICE_TRAY_PSN]-R[17:ICE_TRAY_YOFFSET]    ;
 353:  PR[8:MOD_PSN]=PR[11:ICE_TRAY_PSN]    ;
 354:  PR[6:MOD_RCP_PSN]=PR[8:MOD_PSN]    ;
 355:  JMP LBL[4] ;
 356:   ;
 357:  ! No more receptacles or ;
 358:  ! no more modules left ;
 359:  LBL[996] ;
 360:  END ;
/POS
P[1:"DATUM"]{
   GP1:
	UF : 1, UT : 1,		CONFIG : 'L, 0, 0, 0',
	X =   424.654999  mm,	Y =   183.154999  mm,	Z =     0.000000  mm,
	W =  -180.000000 deg,	P =     0.000000 deg,	R =     0.000000 deg
};
P[2:"FIRST_PIN"]{
   GP1:
	UF : 1, UT : 1,		CONFIG : 'L, 0, 0, 0',
	X =   369.580994  mm,	Y =   174.535004  mm,	Z =     0.000000  mm,
	W =  -180.000000 deg,	P =     0.000000 deg,	R =     0.000000 deg
};
P[3:"CAMERA"]{
   GP1:
	UF : 1, UT : 1,		CONFIG : 'L, 0, 0, 0',
	X =   207.901993  mm,	Y =   332.035004  mm,	Z =    82.065002  mm,
	W =  -180.000000 deg,	P =     0.000000 deg,	R =     0.000000 deg
};
P[4:"FIRST_RCP"]{
   GP1:
	UF : 1, UT : 1,		CONFIG : 'L, 0, 0, 0',
	X =   108.552002  mm,	Y =   190.020996  mm,	Z =     0.000000  mm,
	W =  -180.000000 deg,	P =     0.000000 deg,	R =     0.000000 deg
};
/END
