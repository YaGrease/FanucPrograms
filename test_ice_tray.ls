/PROG  TEST_ICE_TRAY
/ATTR
OWNER		= MNEDITOR;
COMMENT		= "";
PROG_SIZE	= 651;
CREATE		= DATE 26-07-13  TIME 14:19:36;
MODIFIED	= DATE 26-07-13  TIME 14:19:36;
FILE_NAME	= TEST_ICE;
VERSION		= 0;
LINE_COUNT	= 11;
MEMORY_SIZE	= 979;
PROTECT		= READ_WRITE;
TCD:  STACK_SIZE	= 0,
      TASK_PRIORITY	= 50,
      TIME_SLICE	= 0,
      BUSY_LAMP_OFF	= 0,
      ABORT_REQUEST	= 0,
      PAUSE_REQUEST	= 0;
DEFAULT_GROUP	= 1,*,*,*,*;
CONTROL_CODE	= 00000000 00000000;
LOCAL_REGISTERS	= 0,0,0;
/APPL
/APPL
/MN
   1:  UFRAME_NUM=1 ;
   2:  UTOOL_NUM=1 ;
   3:   ;
   4:  PR[1:TMP_DATUM]=P[1:STATIC_MOC_RCP]    ;
   5:   ;
   6:J PR[1:TMP_DATUM] 100% FINE    ;
   7:   ;
   8:  PR[1,2:TMP_DATUM]=PR[1,2:TMP_DATUM]-107.886    ;
   9:  WAIT   1.00(sec) ;
  10:   ;
  11:J PR[1:TMP_DATUM] 100% FINE    ;
/POS
P[1:"STATIC_MOC_RCP"]{
   GP1:
	UF : 1, UT : 1,		CONFIG : 'L, 0, 0, 0',
	X =      .096000  mm,	Y =   184.095001  mm,	Z =    20.125000  mm,
	W =   180.000000 deg,	P =     0.000000 deg,	R =     0.000000 deg
};
/END
